{
  "name": "ascii-miniapp",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "electron-main.js",
  "scripts": {
    "test:pong": "node --test backend/pong.economy.test.js",
    "electron": "electron .",
    "pack:win": "electron-builder --win --dir",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "form-data": "^4.0.1",
    "mime-types": "^2.1.35",
    "multer": "^1.4.5-lts.1",
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.tripchiller.ascii-visor",
    "productName": "ASCII VISOR Beta",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "local.html",
      "ascii.js",
      "styles.css",
      "electron-main.js",
      "preload.js",
      "local-adapter.js",
      "assets/**/*",
      "package.json",
      "node_modules/**/*",
      "!*.diff",
      "!*.zip",
      "!visor-current-debug.zip",
      "!visor-debug-overlay.zip",
      "!visor-debug-extracted-*.zip",
      "!*debug*.zip",
      "!*render*.zip"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-${version}-${arch}-beta.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
